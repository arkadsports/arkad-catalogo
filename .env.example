# Copie este arquivo para ".env" e preencha. O ".env" não vai para o Git.

# Endereço do catálogo do fornecedor no Yupoo, sem barra no final.
# Fica aqui e não no código porque o repositório é público.
# Use com: node --env-file=.env scripts/sync-yupoo.mjs
YUPOO_BASE=

# URL pública das imagens. Deixe vazio para usar a pasta public/img (desenvolvimento).
# Depois de subir as fotos para o Cloudflare R2, coloque aqui a URL pública do bucket,
# por exemplo: https://pub-xxxxxxxx.r2.dev  (e a mesma variável na Vercel)
VITE_IMAGE_BASE=

# Cloudflare R2 (só para "npm run upload-images")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arkad-catalogo
